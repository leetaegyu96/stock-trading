# 한국투자증권 KIS 오픈API — 값은 .env 에만 직접 입력 (커밋 금지)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ENV=real
# PostgreSQL (라이브 모드 상태·이력 영속)
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/simcore
# (선택) DB 테스트용 — 설정 시에만 tests/live 의 DB 테스트 실행
TEST_DATABASE_URL=
# ── 매매 동작 토글 (모두 선택, 미설정 시 config.py 기본값) ──
# 장중 자동매매(10분 스캔). 기본 false — 켜기 전 docs/trading-rules.md §17 확인.
INTRADAY_ENABLED=false
INTRADAY_SCAN_MINUTES=10
# 적신호 점수 매도(9점 부분 / 11점 전량). false = "손절/트레일만" 모드.
# 강제매도(R7 손절·R10 트레일링·R18·R5+R23)는 이 값과 무관하게 항상 유효. §7-1 참고.
SIGNAL_SELL_ENABLED=true
# 동시 보유 종목 수 (기본 5)
MAX_POSITIONS=5
